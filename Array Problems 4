# Balance Finder
arr=[-4,6,2,0,0,1,1]
print("Full array:",arr)
print("Left of index 2:",arr[:2])
print("Right of index 2:",arr[3:])
print("Left sum at index 2:",sum(arr[:2]))
print("Right sum at index 2:",sum(arr[3:]))

print("\nBalance check:")
for i in range(len(arr)):
    L=sum(arr[:1])
    R=sum(arr[i+1:])
    print("index",i,"-> left:",L,"right:",R)

print("\nEquilibrium Point:")
for i in range(len(arr)):
    if sum(arr[:i])==sum(arr[i+1:]):
        print("Index:",i,"Element:",arr[i])
    else:
        print("Equilibrium point not found")

numbers=[3,6,2,2,56,1,0,9]
target=10
print("\nGrowing window(start=1, taregt=",target,"):")
current=0
for j in range(1,len(numbers)):
    current+=numbers[j]
    print("numbers[1 to",j,"]=",numbers[1:j+1],"sum=",current)
    if current>=target:
        break

print("\nSearching all windows:")
found=False
for i in range(len(numbers)):
    if found:
        break
    current=0
    for j in range(i,len(numbers)):
        current+=numbers[j]
        if current==target:
            print("Found! Indexes",i,"to",":",numbers[i:j+1])
            found=True
            break
        if current>target:
            break
if not found:
    print("No subarray found")
