# Target Tracker Lab

# Input array
arr = [2, 4, 1, 3, 5, 2, 6]

print("Array:", arr)

total_sum = sum(arr)
print("\nTotal Sum:", total_sum)

print("\nLeft-Right Balance Check:")

left_sum = 0

for i in range(len(arr)):
    right_sum = total_sum - left_sum - arr[i]

    print(f"Index {i}: Left = {left_sum}, Right = {right_sum}")

    left_sum += arr[i]

print("\nSearching for Equilibrium Point...")

left_sum = 0
equilibrium = -1

for i in range(len(arr)):
    right_sum = total_sum - left_sum - arr[i]

    if left_sum == right_sum:
        equilibrium = i
        break

    left_sum += arr[i]

if equilibrium != -1:
    print("Equilibrium Point Found at Index:", equilibrium)
else:
    print("No Equilibrium Point Found")

print("\nGrowing Subarray Window:")

window_sum = 0

for i in range(len(arr)):
    window_sum += arr[i]
    print(f"Window [0:{i}] -> {arr[:i+1]}  Sum = {window_sum}")

target = 9

print("\nSearching for Target Sum:", target)

found = False

for start in range(len(arr)):
    current_sum = 0

    for end in range(start, len(arr)):
        current_sum += arr[end]

        if current_sum == target:
            print(f"Target found from index {start} to {end}: {arr[start:end+1]}")
            found = True

if not found:
    print("No subarray found with the target sum.")
