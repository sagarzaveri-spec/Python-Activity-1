def seive(n):
    prime=[True for i in range (n+1)]
    p=2
    while (p*p<=n):
        if (prime[p]==True):
            for i in range(p*p,n+1,p):
                prime[i]=False
        p+=1

    for p in range(2,100):
        if prime[p]:
            print(p)

print("Following are the two digit prime numbers")
seive(99)
