# Mean & Median
arr=[1,2,3,43,22,11,34,4,5,6,7,8,9]
arr_size=len(arr)

def arrayMean(arr,arr_size):
    total_sum=0
    for i in range(0,arr_size):
        total_sum+=arr[i]
    mean=total_sum/arr_size
    return mean

def arrayMedian(arr,arr_size):
    sorted(arr)
    if arr_size%2!=0:
        return float(arr[int(arr_size/2)])
    return float((arr[int((arr_size-1)/2)]+arr[int(arr_size/2)])/2.0)

print('Mean = ',arrayMean(arr,arr_size))
print('Median = ',arrayMedian(arr,arr_size))

# # Max & Min Algorithm
# Check length of the array size
# Initialise Maximum and minimum valeu as 0
# Compare each element with the maximum or minimum value and update accordingly
# return maximum and minimum value

def arrayMax(arr,arr_size):
    max=arr[0]
    for i in range(1,arr_size):
        if arr[i]>max:
            max=arr[i]
    return max

def arrayMin(arr,arr_size):
    min=arr[0]
    for i in range(1,arr_size):
        if arr[i]<min:
            min=arr[i]
    return min

print('Maximum element in the array is: ',arrayMax(arr,arr_size))
print('Minimum element in the array is: ',arrayMin(arr,arr_size))

